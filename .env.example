DATABASE_URL=sqlite://look-out-api.db
LOOK_OUT_API_CONFIG=./look-out-api.toml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional custom Bot API server; HTTPS required except for loopback testing.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
RUST_LOG=look_out_api=info
# Optional unless a heartbeat target is configured:
# LOOK_OUT_API_BIND=127.0.0.1:8080
LOOK_OUT_API_HEARTBEAT_TOKEN=
LOOK_OUT_API_HTTP_PROXY=
# Any variable referenced by ${NAME} in your own config must be set.
# API_TOKEN=
# LOOK_OUT_API_USER=
# LOOK_OUT_API_PASS=
